  </property>
  <property name="styleSheet">
   <string notr="true">QMainWindow { background: #f4f7fb; }
QWidget {
    color: #1f2937;
    font-family: &quot;Microsoft YaHei UI&quot;;
    font-size: 14px;
}
QFrame#headerFrame {
    background: #17365d;
    border-radius: 12px;
}
QLabel#labelTitle {
    color: white;
    font-size: 25px;
    font-weight: 700;
}
QLabel#labelSubtitle {
    color: #cbd9eb;
    font-size: 13px;
}
QLabel#labelConnectionStatus {
    color: #334155;
    background: #e2e8f0;
    border-radius: 13px;
    padding: 5px 13px;
    font-weight: 600;
}
QGroupBox {
    background: white;
    border: 1px solid #dbe3ee;
    border-radius: 10px;
    margin-top: 12px;
    padding-top: 12px;
    font-size: 15px;
    font-weight: 700;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 7px;
    color: #17365d;
}
QComboBox, QLineEdit {
    min-height: 34px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 0 10px;
    background: white;
    selection-background-color: #2563eb;
}
QComboBox:hover, QLineEdit:hover { border-color: #7aa2d6; }
QComboBox:focus, QLineEdit:focus { border: 1px solid #2563eb; }
QPushButton {
    min-height: 34px;
    border: 1px solid #b9c6d8;
    border-radius: 6px;
    padding: 0 16px;
    background: #f8fafc;
    font-weight: 600;
}
QPushButton:hover {
    background: #edf3fa;
    border-color: #7aa2d6;
}
QPushButton:pressed { background: #dfe9f5; }
QPushButton:disabled {
    color: #94a3b8;
    background: #eef2f6;
    border-color: #d8e0e9;
}
QPushButton#pushButtonOpenSerial {
    color: white;
    background: #0f766e;
    border-color: #0f766e;
}
QPushButton#pushButtonOpenSerial:hover { background: #0d665f; }
QPushButton#pushButtonStartUpgrade {
    color: white;
    background: #2563eb;
    border-color: #2563eb;
    min-height: 42px;
    font-size: 15px;
}
QPushButton#pushButtonStartUpgrade:hover { background: #1d4ed8; }
QPushButton#pushButtonCancelUpgrade { min-height: 42px; }
QRadioButton { spacing: 8px; font-weight: 600; }
QProgressBar {
    min-height: 24px;
    border: 1px solid #cbd5e1;
    border-radius: 7px;
    background: #eef2f7;
    text-align: center;
    font-weight: 700;
}
QProgressBar::chunk {
    background: #2563eb;
    border-radius: 6px;
}
QPlainTextEdit {
    border: 1px solid #cbd5e1;
    border-radius: 7px;
    background: #0f172a;
    color: #d1e7dd;
    font-family: Consolas, &quot;Microsoft YaHei UI&quot;;
    font-size: 13px;
    padding: 8px;
    selection-background-color: #1d4ed8;
}
QLabel#labelFileSizeValue, QLabel#labelFileCrcValue,
QLabel#labelUpgradeStatusValue, QLabel#labelPacketProgressValue,
QLabel#labelLastResponseValue {
    color: #0f4c81;
    font-weight: 700;
}
QLabel#labelHint { color: #64748b; font-size: 12px; }
QStatusBar { color: #475569; background: #eef2f7; }</string>
  </property>
